rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissões padrão: negar tudo
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção de latas: usuários autenticados podem ler e escrever
    match /cans/{canId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Metadados de catálogo: usuários autenticados podem ler e escrever
    match /catalogMetadata/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Coleção de usuários: cada usuário pode escrever seus próprios dados
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Subcoleção: collection
      match /collection/{collectionId} {
        allow read: if request.auth != null && request.auth.uid == parent.uid;
        allow write: if request.auth != null && request.auth.uid == parent.uid;
      }

      // Subcoleção: wishlist
      match /wishlist/{wishlistId} {
        allow read: if request.auth != null && request.auth.uid == parent.uid;
        allow write: if request.auth != null && request.auth.uid == parent.uid;
      }
    }
  }
}
